# Backend local development
PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/taskforge
CORS_ORIGIN=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
NODE_ENV=development

# Replace these examples with long, unique random values.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
REFRESH_TOKEN_EXPIRY=10d

# SMTP settings. For development, use your email sandbox's SMTP credentials.
MAILTRAP_SMTP_HOST=your-smtp-host
MAILTRAP_SMTP_PORT=2525
MAILTRAP_SMTP_USER=your-smtp-username
MAILTRAP_SMTP_PASS=your-smtp-password
MAIL_FROM="TaskForge <no-reply@example.com>"
